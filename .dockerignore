# Local configuration and secrets. Without this, `ADD . /app` copies .env into
# the image, and utils.py loads it with override=True, replacing the values
# passed to the container (for example by docker compose).
.env
.env.testing

# Local development artifacts
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
htmlcov/
.coverage
*.egg-info/
build/
dist/

# .git is intentionally kept: the version is derived from git tags at build time.

# Repository assets, docs, and tooling not used at runtime. The app serves
# elekto/static/ and elekto/templates/; test/ and test-entrypoint.sh are kept
# for the `test` build stage.
static/
docs/
installation/
scripts/
.github/
docker-compose.yml
build_container.sh
Makefile
environment.yml
.env.example
*.md
!README.md
